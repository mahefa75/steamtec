{% extends 'admin/base.html.twig' %}

{% block title %}{{ user.id ? 'Modifier' : 'Nouvel' }} utilisateur{% endblock %}

{% block header_title %}
    <div class="d-flex align-items-center">
        <div class="me-3">
            <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10" 
                 style="width: 48px; height: 48px;">
                <i class="fas fa-{{ user.id ? 'user-edit' : 'user-plus' }} text-primary"></i>
            </div>
        </div>
        <div>
            <h1 class="mb-0">{{ user.id ? 'Modifier' : 'Nouvel' }} utilisateur</h1>
            <p class="text-secondary mb-0">
                {% if user.id %}
                    Modifier les informations de {{ user.email }}
                {% else %}
                    Ajouter un nouvel utilisateur à la plateforme
                {% endif %}
            </p>
        </div>
    </div>
{% endblock %}

{% block admin_content %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    {% if user.id %}
                        <div class="d-flex align-items-center mb-4">
                            <div class="me-3 rounded bg-secondary bg-opacity-10" 
                                 style="width: 64px; height: 64px; overflow: hidden;">
                                <img src="https://ui-avatars.com/api/?name={{ user.email }}&size=64&background=random" 
                                     alt="" class="w-100 h-100 object-fit-cover">
                            </div>
                            <div>
                                <h5 class="mb-1">{{ user.email }}</h5>
                                <div class="d-flex align-items-center gap-3 text-secondary small">
                                    <span>
                                        <i class="fas fa-fingerprint me-1"></i>
                                        ID: {{ user.id }}
                                    </span>
                                    {% for role in user.roles %}
                                        {% set roleClass = role == 'ROLE_ADMIN' ? 'bg-danger' : 'bg-primary' %}
                                        {% set roleIcon = role == 'ROLE_ADMIN' ? 'fas fa-crown' : 'fas fa-user' %}
                                        <span class="badge {{ roleClass }} bg-opacity-10 text-{{ role == 'ROLE_ADMIN' ? 'danger' : 'primary' }} px-3 py-2">
                                            <i class="{{ roleIcon }} me-1"></i>
                                            {{ role|replace({'ROLE_': ''}) }}
                                        </span>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                        <div class="row g-4">
                            <div class="col-md-12">
                                <div class="form-group">
                                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.email, {
                                        'attr': {
                                            'class': 'form-control form-control-lg',
                                            'placeholder': 'Adresse email'
                                        }
                                    }) }}
                                    {% if form_errors(form.email) %}
                                        <div class="invalid-feedback d-block">
                                            {{ form_errors(form.email) }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-group">
                                    {{ form_label(form.password, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.password, {
                                        'attr': {
                                            'class': 'form-control form-control-lg',
                                            'placeholder': user.id ? 'Laissez vide pour conserver le mot de passe actuel' : 'Mot de passe'
                                        }
                                    }) }}
                                    {% if form_errors(form.password) %}
                                        <div class="invalid-feedback d-block">
                                            {{ form_errors(form.password) }}
                                        </div>
                                    {% endif %}
                                    {% if form_help(form.password) %}
                                        <div class="form-text text-secondary small mt-2">
                                            {{ form_help(form.password) }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-group">
                                    {{ form_label(form.roles, null, {'label_attr': {'class': 'form-label'}}) }}
                                    <div class="role-options">
                                        {% for role in form.roles %}
                                            <div class="role-option">
                                                {{ form_widget(role, {
                                                    'attr': {
                                                        'class': 'btn-check'
                                                    }
                                                }) }}
                                                <label class="role-label" for="{{ role.vars.id }}">
                                                    {% set isAdmin = 'ROLE_ADMIN' in role.vars.value %}
                                                    <i class="fas fa-{{ isAdmin ? 'crown' : 'user' }} me-2"></i>
                                                    {{ role.vars.label }}
                                                </label>
                                            </div>
                                        {% endfor %}
                                    </div>
                                    {% if form_errors(form.roles) %}
                                        <div class="invalid-feedback d-block mt-2">
                                            {{ form_errors(form.roles) }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="{{ path('app_admin_user_index') }}" class="btn btn-light">
                                <i class="fas fa-arrow-left me-2"></i>Retour
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-{{ user.id ? 'save' : 'plus' }} me-2"></i>
                                {{ user.id ? 'Enregistrer les modifications' : 'Créer l\'utilisateur' }}
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <style>
        .form-control, .form-select {
            background-color: var(--secondary-bg);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
        }
        .form-control:focus, .form-select:focus {
            background-color: var(--secondary-bg);
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25);
            color: var(--text-primary);
        }
        .form-control::placeholder {
            color: var(--text-secondary);
        }
        .form-label {
            color: var(--text-secondary);
            font-weight: 500;
            margin-bottom: 0.5rem;
        }
        .invalid-feedback {
            font-size: 0.875rem;
            margin-top: 0.5rem;
            color: var(--danger-color);
        }
        .role-options {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }
        .role-option {
            position: relative;
        }
        .btn-check {
            position: absolute;
            clip: rect(0,0,0,0);
            pointer-events: none;
        }
        .role-label {
            display: flex;
            align-items: center;
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background-color: var(--secondary-bg);
            color: var(--text-primary);
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .role-label:hover {
            background-color: rgba(255, 255, 255, 0.05);
            border-color: var(--primary-color);
        }
        .btn-check:checked + .role-label {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: #ffffff;
        }
        .object-fit-cover {
            object-fit: cover;
        }
    </style>
{% endblock %} 