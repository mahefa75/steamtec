{% extends 'admin/base.html.twig' %}

{% block title %}{{ machine.id ? 'Modifier' : 'Nouvelle' }} machine{% endblock %}

{% block header_title %}
    <div class="d-flex align-items-center">
        <div class="me-3">
            <div class="d-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10" 
                 style="width: 48px; height: 48px;">
                <i class="fas fa-{{ machine.id ? 'edit' : 'plus' }} text-success"></i>
            </div>
        </div>
        <div>
            <h1 class="mb-0">{{ machine.id ? 'Modifier' : 'Nouvelle' }} machine</h1>
            <p class="text-secondary mb-0">
                {% if machine.id %}
                    Modifier les informations de {{ machine.name }}
                {% else %}
                    Ajouter une nouvelle machine à la plateforme
                {% endif %}
            </p>
        </div>
    </div>
{% endblock %}

{% block admin_content %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    {% if machine.id %}
                        <div class="d-flex align-items-center mb-4">
                            <div class="me-3">
                                {% if machine.imageUrl %}
                                    <div class="rounded bg-secondary bg-opacity-10" 
                                         style="width: 64px; height: 64px; overflow: hidden;">
                                        <img src="{{ machine.imageUrl }}" 
                                             alt="" class="w-100 h-100 object-fit-cover">
                                    </div>
                                {% else %}
                                    <div class="d-flex align-items-center justify-content-center rounded bg-secondary bg-opacity-10" 
                                         style="width: 64px; height: 64px;">
                                        <i class="fas fa-cog fa-2x text-secondary"></i>
                                    </div>
                                {% endif %}
                            </div>
                            <div>
                                <h5 class="mb-1">{{ machine.name }}</h5>
                                <div class="d-flex align-items-center gap-3 text-secondary small">
                                    <span>
                                        <i class="fas fa-fingerprint me-1"></i>
                                        ID: {{ machine.id }}
                                    </span>
                                    <span>
                                        <i class="fas fa-tag me-1"></i>
                                        {{ machine.model }}
                                    </span>
                                    <span>
                                        <i class="fas fa-clock me-1"></i>
                                        {{ machine.updatedAt ? 'Modifié le ' ~ machine.updatedAt|date('d/m/Y H:i') : 'Créé le ' ~ machine.createdAt|date('d/m/Y H:i') }}
                                    </span>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.name, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.name, {
                                        'attr': {
                                            'class': 'form-control form-control-lg',
                                            'placeholder': 'Nom de la machine'
                                        }
                                    }) }}
                                    {% if form_errors(form.name) %}
                                        <div class="invalid-feedback d-block">
                                            {{ form_errors(form.name) }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.model, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.model, {
                                        'attr': {
                                            'class': 'form-control form-control-lg',
                                            'placeholder': 'Modèle de la machine'
                                        }
                                    }) }}
                                    {% if form_errors(form.model) %}
                                        <div class="invalid-feedback d-block">
                                            {{ form_errors(form.model) }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-group">
                                    {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.description, {
                                        'attr': {
                                            'class': 'form-control',
                                            'rows': 5,
                                            'placeholder': 'Description détaillée de la machine'
                                        }
                                    }) }}
                                    {% if form_errors(form.description) %}
                                        <div class="invalid-feedback d-block">
                                            {{ form_errors(form.description) }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-group">
                                    {{ form_label(form.imageUrl, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.imageUrl, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': 'URL de l\'image'
                                        }
                                    }) }}
                                    {% if form_errors(form.imageUrl) %}
                                        <div class="invalid-feedback d-block">
                                            {{ form_errors(form.imageUrl) }}
                                        </div>
                                    {% endif %}
                                    {% if machine.imageUrl %}
                                        <div class="image-preview mt-3 p-3 rounded" style="background-color: var(--secondary-bg);">
                                            <div class="d-flex align-items-center">
                                                <div class="me-3 rounded bg-secondary bg-opacity-10" 
                                                     style="width: 100px; height: 100px; overflow: hidden;">
                                                    <img src="{{ machine.imageUrl }}" alt="{{ machine.name }}" 
                                                         class="w-100 h-100 object-fit-cover">
                                                </div>
                                                <div class="text-secondary">
                                                    <h6 class="mb-1">Image actuelle</h6>
                                                    <p class="small mb-0">
                                                        <i class="fas fa-info-circle me-1"></i>
                                                        Laissez le champ vide pour supprimer l'image
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="{{ path('app_admin_machine_index') }}" class="btn btn-light">
                                <i class="fas fa-arrow-left me-2"></i>Retour
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-{{ machine.id ? 'save' : 'plus' }} me-2"></i>
                                {{ machine.id ? 'Enregistrer les modifications' : 'Créer la machine' }}
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <style>
        .form-control, .form-select {
            background-color: var(--secondary-bg);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
        }
        .form-control:focus, .form-select:focus {
            background-color: var(--secondary-bg);
            border-color: var(--success-color);
            box-shadow: 0 0 0 0.25rem rgba(34, 197, 94, 0.25);
            color: var(--text-primary);
        }
        .form-control::placeholder {
            color: var(--text-secondary);
        }
        .form-label {
            color: var(--text-secondary);
            font-weight: 500;
            margin-bottom: 0.5rem;
        }
        .invalid-feedback {
            font-size: 0.875rem;
            margin-top: 0.5rem;
            color: var(--danger-color);
        }
        .image-preview {
            border: 1px solid var(--border-color);
            transition: all 0.2s ease;
        }
        .image-preview:hover {
            border-color: var(--success-color);
            background-color: rgba(34, 197, 94, 0.1) !important;
        }
        .object-fit-cover {
            object-fit: cover;
        }
    </style>
{% endblock %} 