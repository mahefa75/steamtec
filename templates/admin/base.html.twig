<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    
    {% block stylesheets %}
        {{ encore_entry_link_tags('admin') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('admin') }}
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    {% endblock %}
</head>
<body>
    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <div class="logo">SteamTec</div>
            <nav>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') starts with 'app_admin_dashboard' %}active{% endif %}" 
                           href="{{ path('app_admin_dashboard') }}" title="Tableau de bord">
                            <i class="fas fa-th-large"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') starts with 'app_admin_transactions' %}active{% endif %}"
                           href="{{ path('app_admin_user_index') }}" title="Transactions">
                            <i class="fas fa-exchange-alt"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') starts with 'app_admin_stats' %}active{% endif %}"
                           href="{{ path('app_admin_machine_index') }}" title="Statistiques">
                            <i class="fas fa-chart-bar"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') starts with 'app_admin_messages' %}active{% endif %}"
                           href="{{ path('app_admin_troubleshooting_index') }}" title="Messages">
                            <i class="fas fa-comments"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_logout') }}" title="Déconnexion">
                            <i class="fas fa-sign-out-alt"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <main class="admin-main">
            <header class="admin-header">
                <div class="header-info">
                    <h1 class="header-title">{% block header_title %}Transactions{% endblock %}</h1>
                    <div class="header-meta">4:45 pm 21 Jul 2023</div>
                </div>
                <div class="user-menu">
                    <div class="menu-icons">
                        <button class="icon-button" title="Notifications">
                            <i class="far fa-bell"></i>
                        </button>
                        <button class="icon-button" title="Messages">
                            <i class="far fa-comment-dots"></i>
                        </button>
                    </div>
                    <div class="user-info">
                        <div class="user-details">
                            <div class="user-name">{{ app.user.email }}</div>
                            <div class="user-role">Project Manager</div>
                        </div>
                        <div class="user-avatar">
                            <img src="https://ui-avatars.com/api/?name={{ app.user.email }}&background=random" 
                                 alt="Avatar">
                        </div>
                    </div>
                </div>
            </header>

            <div class="admin-content">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block admin_content %}{% endblock %}
            </div>
        </main>
    </div>
</body>
</html> 